# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local data the scripts produce. These hold customer phone numbers — the
# manifest alone has over twenty thousand — so they must never reach the
# repository. Nothing the app serves reads them; they are regenerable from
# the dialer or from the bucket.
/morpheus-*.json
/morpheus-*.jsonl
/morpheus-uploaded.txt

# Run logs from the daily pull, and the copies taken before editing a script.
/logs/
*.bak
*.bak[0-9]
